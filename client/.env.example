# Copy this file to ".env" only if you need to override the backend URL.
# The real ".env" is ignored by git.

# The base URL of the backend API.
# In development you can leave this unset; the app defaults to
# http://localhost:3001. In production (Vercel) set it to your deployed
# backend's URL, e.g. https://your-backend.onrender.com
VITE_API_URL=
