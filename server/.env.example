# Copy this file to ".env" and fill in the values you want.
# The real ".env" is ignored by git, so secrets never get committed.

# Optional. A GitHub personal access token raises the API rate limit
# from 60 requests/hour to 5000/hour. Create one (no scopes needed for
# public data) at: https://github.com/settings/tokens
GITHUB_TOKEN=

# The port the server listens on. Defaults to 3001 if left unset.
PORT=3001
